APP_ENV=local
APP_NAME="Enterprise Knowledge Intelligence Platform"
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# Database & Cache (Docker local services)
DATABASE_URL=postgresql+asyncpg://ekip_user:ekip_password@localhost:5432/ekip_db
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Vector Embeddings
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024

# LLM Synthesis & Resilience
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Reranking & Semantic Caching
RERANKER_PROVIDER=fastembed
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_PROVIDER=redis
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=86400